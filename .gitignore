# Ignore Claude Code local settings containing API keys
.claude/

# Ignore Windows executable files
*.exe

# General system and build ignores
.DS_Store
*.log
node_modules/
dist/
build/
__pycache__/
models/

# Terraform: never commit state, plans, or provider binaries.
# .terraform.lock.hcl IS committed on purpose (pins provider versions).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
