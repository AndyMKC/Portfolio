{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug StorySpark Server",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false,
      "debugOptions": [
        "RedirectOutput"
      ],
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/src"
        }
      ]
    }
  ]
}
